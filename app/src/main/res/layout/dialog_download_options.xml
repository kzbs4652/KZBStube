<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kzbs_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvOptionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Format Seçin"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Video (MP4)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ses (MP3)"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Kalite Seçin"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgQuality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/q1080"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1080p FHD   (146 MB)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/q720"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="720p HD      (82 MB)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/q480"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="480p         (46 MB)"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/q360"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="360p         (28 MB)"
            android:textColor="@color/text_primary" />
    </RadioGroup>

    <Button
        android:id="@+id/btnStartDownload"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_red_button"
        android:text="↓ İndirmeyi Başlat"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

</LinearLayout>
